# Prophet Arena platform key (prophet login also stores it in ~/.arena/credentials.json)
ARENA_API_KEY=pa_live_...

# OpenRouter key powering the ensemble
OPENROUTER_API_KEY=sk-or-...

# Ensemble configuration (defaults shown)
PA_MODELS=anthropic/claude-opus-5.5,openai/gpt-6-astra,google/gemini-3.1-pro-preview,moonshotai/kimi-k3.1-pro
PA_SAMPLES_PER_MODEL=2
PA_TEMPERATURE=0.6
PA_CROWD_WEIGHT=0.25
PA_EXTREMIZE=1.15
PA_CLAMP=0.005
PA_MAX_CONCURRENCY=8
PA_ONLINE=1
